[options]
# Replaced automatically by run.sh in each deployed project.
admin_passwd = __ODOO_MASTER_PASSWORD__

addons_path = /mnt/extra-addons,/mnt/enterprise
data_dir = /var/lib/odoo
logfile = /var/log/odoo/odoo-server.log
log_level = info

# Enabled only for first-time database creation.
# Run ./finalize.sh <database_name> after creating the production database.
list_db = True

# The production path is through Nginx Proxy Manager on the private proxy network.
proxy_mode = True

# Conservative, configurable defaults for a multi-instance host.
workers = __ODOO_WORKERS__
max_cron_threads = __ODOO_MAX_CRON_THREADS__
db_maxconn = __ODOO_DB_MAXCONN__

limit_time_cpu = 60
limit_time_real = 120
