[options]
# Replaced automatically by run.sh in each deployed project.
admin_passwd = __ODOO_MASTER_PASSWORD__

addons_path = /mnt/extra-addons,/mnt/enterprise
data_dir = /var/lib/odoo
logfile = /var/log/odoo/odoo-server.log
log_level = info

# Keep the database manager available so the country/language can be selected manually.
list_db = True

# Enable only when Odoo is behind a correctly configured trusted reverse proxy.
proxy_mode = False

# Conservative defaults for a portable multi-instance host.
workers = 2
max_cron_threads = 1
db_maxconn = 64

limit_time_cpu = 60
limit_time_real = 120
