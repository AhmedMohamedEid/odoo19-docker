# run.sh creates .env automatically for each deployed instance.
COMPOSE_PROJECT_NAME=customer-sa
ODOO_VERSION=19.0

# Installed instances pin exact image digests after pulling the latest versions
# available at install time. These tag values are only template fallbacks.
ODOO_BASE_IMAGE=odoo:19.0
POSTGRES_VERSION=16
POSTGRES_IMAGE=postgres:16

# Existing Nginx Proxy Manager Docker network.
# On the audited production host this is "proxy-tier".
PROXY_NETWORK=proxy-tier
ODOO_PROXY_ALIAS=customer-sa-odoo

# Host ports remain available for local diagnostics only.
ODOO_BIND_IP=127.0.0.1
ODOO_PORT=10019
ODOO_GEVENT_PORT=20019

# Runtime tuning used to generate config/odoo.conf.
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1
ODOO_DB_MAXCONN=16

POSTGRES_DB=postgres
POSTGRES_USER=odoo
POSTGRES_PASSWORD=replace-with-a-random-secret
